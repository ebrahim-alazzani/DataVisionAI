<Page
    x:Class="DataVision.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="28,24,28,32" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Section 1: Developer Info & Branding -->
            <Border CornerRadius="16" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Developer / App Logo -->
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="16" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="2" Padding="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/logo.png" Stretch="Uniform" />
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="DataVision Studio" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#0284C7" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0 (WinUI 3)" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="تطوير وإشراف: إبراهيم العزاني (Ebrahim Al-Azzani)" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" />
                        <TextBlock Text="منصة استخبارات الأعمال وتحليل ملفات الإكسل والجداول التنفيذية وفق معايير Clean Architecture و SOLID Principles." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section 2: Architecture & SOLID Standards -->
            <Border CornerRadius="14" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="المعايير الهندسية وأنماط التصميم (Software Architecture)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Clean Architecture &amp; MVVM" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" />
                                <TextBlock Text="فصل تام بين طبقات العرض ونماذج البيانات ومحركات التحليل عبر Interfaces و Dependency Injection." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SOLID Principles Compliant" FontWeight="Bold" FontSize="12.5" Foreground="#10B981" />
                                <TextBlock Text="التزام صارم بمبادئ المسؤولية الفردية (SRP) وفصل الواجهات (ISP) وعكس التبعية (DIP) لكود نقي وقابل للصيانة." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Engine Specifications -->
            <Border CornerRadius="14" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="المواصفات التقنية للمحرك" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="• الواجهة: Windows App SDK 1.6 · WinUI 3 · Windows 11 Fluent Design" FontSize="12" Foreground="#94A3B8" />
                    <TextBlock Text="• منصة التشغيل: .NET 9.0 (x64 Unpackaged / Self-Contained)" FontSize="12" Foreground="#94A3B8" />
                    <TextBlock Text="• الخوارزميات: إحصاء وصفي كامل (IQR, Percentiles, Tukey Fences, Variance, Standard Deviation)" FontSize="12" Foreground="#94A3B8" />
                    <TextBlock Text="• الأداء: معالجة محلية 100% دون أي اتصال خارجي أو تسريب لبيانات العمل" FontSize="12" Foreground="#34D399" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
