<Page
    x:Class="DataVision.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="28,24,28,32" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Section 1: AI Engine Configuration -->
            <Border CornerRadius="12" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="محرك الذكاء الاصطناعي (AI Configuration)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="يدعم التطبيق محرك التحليل الإحصائي المحلي مجاناً وبدون إنترنت. للحصول على تحليل واستنتاجات متقدمة جداً، يمكنك إضافة مفتاح Google Gemini المجاني." FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Google Gemini API Key (مجاني)" FontSize="12" Foreground="#94A3B8" />
                        <PasswordBox x:Name="TxtApiKey" PlaceholderText="ألصق مفتاح Gemini هنا (يبدأ بـ AIzaSy...)" CornerRadius="8" PasswordChanged="TxtApiKey_PasswordChanged" />
                        <TextBlock Text="* يمكنك استخراج مفتاح مجاني في ثوانٍ من aistudio.google.com" FontSize="11" Foreground="#38BDF8" />
                    </StackPanel>

                    <Button x:Name="BtnSaveKey" Click="BtnSaveKey_Click" Background="{ThemeResource DvGradientPrimary}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="16,8" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                            <TextBlock Text="حفظ المفتاح" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Section 2: Application Info -->
            <Border CornerRadius="12" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="حول منصة DataVision AI" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="منصة ذكية متخصصة في قراءة وتحليل ومعالجة ملفات الإكسل (XLSX, XLS, CSV) واستخراج المؤشرات الإحصائية وتوليد الرسوم البيانية التفاعلية المدعومة بالذكاء الاصطناعي." FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="إصدار: 1.0.0 (WinUI 3 · .NET 9)" FontSize="11" Foreground="#38BDF8" />
                        </Border>
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="الواجهة: Windows App SDK 1.6" FontSize="11" Foreground="#818CF8" />
                        </Border>
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="المحرك: Gemini 1.5 + Local Stats" FontSize="11" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
