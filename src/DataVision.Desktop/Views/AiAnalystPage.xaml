<Page
    x:Class="DataVision.Desktop.Views.AiAnalystPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DataVision.Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Top Header & Suggestions -->
        <Border Grid.Row="0" CornerRadius="12" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="مساعد تحليل الأعمال الذكي · Ask Your Data" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                    <TextBlock Text="Gemini AI + Local Engine" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="اطرح أي استفسار حول ملف الإكسل أو اضغط على أحد الأسئلة المقترحة أدناه:" FontSize="12" Foreground="#94A3B8" />

                <!-- Prompt Suggestion Pills -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="📊 ما هي أعلى 5 فئات بالأرقام؟" Click="OnPillClick" Background="#1E293B" Foreground="#38BDF8" CornerRadius="8" Padding="12,6" />
                        <Button Content="⚠️ هل توجد قيم شاذة أو خلايا فارغة؟" Click="OnPillClick" Background="#1E293B" Foreground="#F59E0B" CornerRadius="8" Padding="12,6" />
                        <Button Content="💡 قدم ملخصاً تنفيذياً لتقديمه للإدارة" Click="OnPillClick" Background="#1E293B" Foreground="#34D399" CornerRadius="8" Padding="12,6" />
                        <Button Content="📈 ما هي أهم التوصيات الاستراتيجية؟" Click="OnPillClick" Background="#1E293B" Foreground="#A78BFA" CornerRadius="8" Padding="12,6" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Chat Conversation Messages -->
        <Border Grid.Row="1" CornerRadius="14" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
            <ListView x:Name="LvChat" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatEntry">
                        <Grid Margin="0,6,0,6">
                            <!-- AI Bubble (Align Right in RTL) -->
                            <Border CornerRadius="12"
                                    Padding="14,12"
                                    MaxWidth="650"
                                    HorizontalAlignment="{x:Bind IsAi, Converter={StaticResource BoolToAlignmentConverter}, FallbackValue=Right}"
                                    Background="{x:Bind IsAi, Converter={StaticResource BoolToBgBrushConverter}, FallbackValue='#1E293B'}"
                                    BorderBrush="#334155"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Sender}" FontWeight="Bold" FontSize="11" Foreground="{x:Bind IsAi, Converter={StaticResource BoolToSenderColorConverter}, FallbackValue='#38BDF8'}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind TimeFormatted}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Left" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Message}" FontSize="12.5" Foreground="#F1F5F9" TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Thinking Progress Bar -->
        <ProgressBar x:Name="PbThinking" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,8" />

        <!-- Input Box & Send Button -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtInput"
                     PlaceholderText="اكتب سؤالك عن البيانات هنا (مثلاً: حلل لي الأرقام واقترح خطة لزيادة المبيعات)..."
                     FontSize="13"
                     CornerRadius="10"
                     Padding="14,10"
                     KeyDown="TxtInput_KeyDown" />

            <Button x:Name="BtnSend"
                    Grid.Column="1"
                    Click="BtnSend_Click"
                    Background="{ThemeResource DvGradientPrimary}"
                    Foreground="White"
                    FontWeight="Bold"
                    CornerRadius="10"
                    Padding="22,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                    <TextBlock Text="إرسال" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
