<Page
    x:Class="DataVision.Desktop.Views.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowDefinitions="Auto,*">
        <!-- Top Controls: Select Column, Select Value, Select Type -->
        <Border Grid.Row="0" CornerRadius="12" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="18" Margin="0,0,0,18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="محور التصنيف (الفئات X-Axis)" FontSize="12" Foreground="#94A3B8" />
                    <ComboBox x:Name="CmbCategoryCol" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="محور القيمة الرقمية (Y-Axis)" FontSize="12" Foreground="#94A3B8" />
                    <ComboBox x:Name="CmbValueCol" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="نوع المخطط البياني" FontSize="12" Foreground="#94A3B8" />
                    <ComboBox x:Name="CmbChartType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnSelectionChanged">
                        <ComboBoxItem Content="أعمدة (Bar Chart)" Tag="bar" />
                        <ComboBoxItem Content="خط بياني (Line Chart)" Tag="line" />
                        <ComboBoxItem Content="مساحي (Area Chart)" Tag="area" />
                        <ComboBoxItem Content="دائري مجوف (Donut Chart)" Tag="donut" />
                        <ComboBoxItem Content="راداري (Radar)" Tag="radar" />
                    </ComboBox>
                </StackPanel>

                <Button x:Name="BtnRefreshChart"
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Click="BtnRefreshChart_Click"
                        Background="{ThemeResource DvGradientPrimary}"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="8"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="تحديث الرسم" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Chart Display -->
        <Border Grid.Row="1" CornerRadius="14" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
            <WebView2 x:Name="MainChartView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</Page>
