<Page
    x:Class="DataVision.Desktop.Views.AnalyticsSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DataVision.Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Top Header & Fast Statistical Queries -->
        <Border Grid.Row="0" CornerRadius="12" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="وحدة الاستعلام الإحصائي والفحص التنفيذي (Statistical Query Console)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                    <TextBlock Text="محرك خوارزمي محلي 100%" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="اختر أحد الاستعلامات الإحصائية السريعة أدناه أو اكتب استفسارك في الخانة المخصصة:" FontSize="12" Foreground="#94A3B8" />

                <!-- Fast Query Buttons -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="📊 فحص الأعمدة والهيكل" Click="OnPillClick" Background="#1E293B" Foreground="#38BDF8" CornerRadius="8" Padding="12,6" />
                        <Button Content="⚠️ فحص القيم الشاذة والخلايا الفارغة" Click="OnPillClick" Background="#1E293B" Foreground="#F59E0B" CornerRadius="8" Padding="12,6" />
                        <Button Content="📈 المؤشرات الإحصائية للأعمدة الرقمية" Click="OnPillClick" Background="#1E293B" Foreground="#34D399" CornerRadius="8" Padding="12,6" />
                        <Button Content="📋 ملخص تنفيذي شامل" Click="OnPillClick" Background="#1E293B" Foreground="#A78BFA" CornerRadius="8" Padding="12,6" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Console Log Output Area -->
        <Border Grid.Row="1" CornerRadius="14" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
            <ListView x:Name="LvConsole" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsoleLogEntry">
                        <Grid Margin="0,6,0,6">
                            <Border CornerRadius="12"
                                    Padding="14,12"
                                    MaxWidth="700"
                                    HorizontalAlignment="{x:Bind IsSystem, Converter={StaticResource BoolToAlignmentConverter}, FallbackValue=Right}"
                                    Background="{x:Bind IsSystem, Converter={StaticResource BoolToBgBrushConverter}, FallbackValue='#1E293B'}"
                                    BorderBrush="#334155"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Sender}" FontWeight="Bold" FontSize="11" Foreground="{x:Bind IsSystem, Converter={StaticResource BoolToSenderColorConverter}, FallbackValue='#38BDF8'}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind TimeFormatted}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Left" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Message}" FontFamily="Consolas, Segoe UI" FontSize="12.5" Foreground="#F1F5F9" TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar x:Name="PbComputing" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,8" />

        <!-- Input Query & Run Button -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtInput"
                     PlaceholderText="اكتب استعلامك الإحصائي هنا (مثال: احسب المتوسطات، أو افحص القيم الشاذة)..."
                     FontSize="13"
                     CornerRadius="10"
                     Padding="14,10"
                     KeyDown="TxtInput_KeyDown" />

            <Button x:Name="BtnRunQuery"
                    Grid.Column="1"
                    Click="BtnRunQuery_Click"
                    Background="{ThemeResource DvGradientPrimary}"
                    Foreground="White"
                    FontWeight="Bold"
                    CornerRadius="10"
                    Padding="22,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="تنفيذ الاستعلام" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
