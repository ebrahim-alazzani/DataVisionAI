<Window
    x:Class="DataVision.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DataVision Studio · استخبارات الأعمال والتحليلات الإحصائية المتقدمة">

    <Grid Background="#0B0F19">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="Auto" />
            <!-- App Main Body -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
                Height="50"
                Background="#0D131F"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,0,16,0">
            <Grid x:Name="AppTitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" Padding="3">
                        <Image Source="ms-appx:///Assets/logo.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="DATAVISION STUDIO" FontWeight="Black" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" CharacterSpacing="60" />
                    <TextBlock Text="BUSINESS INTELLIGENCE &amp; ANALYTICS" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" CharacterSpacing="70" />
                </StackPanel>

                <!-- Developer Attribution Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                    <Border Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="بواسطة: إبراهيم العزاني" FontSize="10.5" Foreground="#94A3B8" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Frame -->
        <Grid Grid.Row="1">
            <NavigationView x:Name="NavView"
                            PaneDisplayMode="LeftCompact"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="True"
                            OpenPaneLength="220"
                            CompactPaneLength="56"
                            SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="لوحة المؤشرات التنفيذية" Tag="dashboard">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="الرسوم البيانية التفاعلية" Tag="charts">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="الاستعلام الإحصائي" Tag="analytics">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="توصيف وهيكل الأعمدة" Tag="preview">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8C0;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Height="30" Background="#0D131F" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="StatusRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtStatus" Text="جاهز لاستقبال ملف الإكسل أو CSV" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="WinUI 3 · .NET 9 · Clean Architecture · SOLID" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
