<Application
    x:Class="DataVision.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DataVision.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
            <converters:BoolToBgBrushConverter x:Key="BoolToBgBrushConverter" />
            <converters:BoolToSenderColorConverter x:Key="BoolToSenderColorConverter" />

            <!-- DataVision Modern Color Palette -->
            <Color x:Key="DvPrimaryColor">#0EA5E9</Color>
            <Color x:Key="DvSecondaryColor">#6366F1</Color>
            <Color x:Key="DvEmeraldColor">#10B981</Color>
            <Color x:Key="DvAmberColor">#F59E0B</Color>
            <Color x:Key="DvRoseColor">#F43F5E</Color>

            <SolidColorBrush x:Key="DvPrimaryBrush" Color="{StaticResource DvPrimaryColor}" />
            <SolidColorBrush x:Key="DvSecondaryBrush" Color="{StaticResource DvSecondaryColor}" />
            <SolidColorBrush x:Key="DvEmeraldBrush" Color="{StaticResource DvEmeraldColor}" />
            <SolidColorBrush x:Key="DvAmberBrush" Color="{StaticResource DvAmberColor}" />
            <SolidColorBrush x:Key="DvRoseBrush" Color="{StaticResource DvRoseColor}" />

            <!-- Gradients -->
            <LinearGradientBrush x:Key="DvGradientPrimary" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#0EA5E9" Offset="0.0" />
                <GradientStop Color="#6366F1" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DvGradientEmerald" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#10B981" Offset="0.0" />
                <GradientStop Color="#059669" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Card & Surface Brushes -->
            <SolidColorBrush x:Key="DvCardBgDarkBrush" Color="#131B2A" Opacity="0.92" />
            <SolidColorBrush x:Key="DvCardBorderDarkBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="DvSurfaceHeaderDarkBrush" Color="#0D131F" Opacity="0.96" />

            <!-- Base Global Styles -->
            <Style TargetType="Button" x:Key="DvPrimaryButtonStyle">
                <Setter Property="Background" Value="{StaticResource DvGradientPrimary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8,16,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
